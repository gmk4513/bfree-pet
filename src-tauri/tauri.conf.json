{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bfree Pet",
  "version": "0.1.2",
  "identifier": "com.gangmini.bfreepet",

  "build": {
    "frontendDist": "../ui"
  },

  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,

    "windows": [
      {
        "label": "main",
        "title": "학사모 비프리",
        "width": 1280,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "shadow": false,
        "focus": false
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "gangmin",
    "copyright": "© gangmin",
    "shortDescription": "학사모 비프리 데스크톱 펫",
    "longDescription": "학사모 비프리가 바탕화면 아래를 걸어 다니며 가끔 멈춰 포즈를 잡고 한마디씩 합니다.",
    "category": "Entertainment",

    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"]
      }
    },

    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
